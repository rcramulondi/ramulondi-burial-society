# PostgreSQL (Neon/Supabase). DATABASE_URL is the pooled connection used at runtime;
# DIRECT_URL is the unpooled connection used for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Private file storage for ID proof / death certificate uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Shared secret checked on the /api/cron/update-member-status endpoint
CRON_SECRET="generate-a-random-string"

# Gmail SMTP — used to email members their proof of payment. Requires
# 2-Step Verification on the Gmail account and an App Password generated at
# myaccount.google.com/apppasswords (NOT the account's normal login
# password). If either var is unset, email sending no-ops with a warning
# rather than failing — the app works fully without it, emails just won't
# go out.
GMAIL_USER="yourgroup@gmail.com"
GMAIL_APP_PASSWORD="16-character app password, no spaces"
